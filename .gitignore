# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# PyInstaller output. Both are reproducible with build-exe.bat, and lz.exe
# is a 9 MB binary that would bloat the history on every rebuild.
build/
dist/

# Generated by tools/make_icon.py, which build-exe.bat runs first.
lz.ico
lz-icon-preview.png

# Structures are other people's data and RCSB is the authoritative copy.
# Fetch them with: python tools/fetch_structure.py 2ZTA
structures/*.pdb
structures/*.cif

# Program output. These are results, not source: regenerate them rather
# than committing one run's answers.
complexes.fasta
*_candidates.csv
lz_selftest.txt
lz-selftest.txt
docking/

# Local scratch
*.log
scratch/
